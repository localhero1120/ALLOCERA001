# Flask Application Secret Key
SECRET_KEY=exam-allocation-super-secret-key-2025-token

# 1. Database (Neon Serverless PostgreSQL)
# Paste your Neon connection string here (with sslmode=require):
DATABASE_URL=postgresql://username:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Private Cloud Object Storage - Backblaze B2 (S3-Compatible API)
B2_KEY_ID=your_backblaze_b2_key_id
B2_APPLICATION_KEY=your_backblaze_b2_application_key
B2_BUCKET_NAME=allocera-storage
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# 3. Server Configuration (Render automatically sets $PORT)
PORT=5050
FLASK_DEBUG=false
